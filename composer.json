{
    "name": "bitka-de/brick-framework",
    "description": "A small, fast and easy-to-use PHP framework for small web projects",
    "type": "framework",
    "keywords": ["php", "framework", "web", "mvc"],
    "license": "MIT",
    "authors": [
        {
            "name": "JP Behrens",
            "email": "jp@bitka.de",
            "homepage": "https://bitka.de"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Brick\\": "brick/",
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    }
}